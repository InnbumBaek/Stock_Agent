# 이 파일을 .env 로 복사한 뒤 값을 채우십시오.
#
# 놓을 곳은 **저장소 바깥**입니다.
#   윈도우   %USERPROFILE%\Stock-Agent-keys\.env
#   그 외    ~/Stock-Agent-keys/.env
#   덮어쓰기 환경변수 STOCK_AGENT_KEYS
#
# 저장소 안(stock-monitor/.env)에 두어도 읽습니다 — 쓰던 설정을 깨지 않기
# 위해서입니다. 다만 그쪽은 .gitignore 에만 기대는 자리라 권하지 않습니다.
# 옮기려면:  python ki_monitor.py migrate-keys
#
# 옮기는 것은 키뿐입니다. 원장·워치리스트·포지션·리포트는 원래 자리 그대로입니다.

# 한국거래소 데이터 오픈 API (서비스별 URL 사용신청 필요)
KRX_API_KEY=

# 금융감독원 DART 오픈 API
DART_API_KEY=

# 해외 매크로 (선택) — https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# 한국은행 ECOS (선택)
ECOS_API_KEY=

# 한국투자증권 KIS 오픈 API — 실시간 시세 (선택)
# 없으면 원장의 KRX 일별 종가로 돌아갑니다. 주문 API 는 호출하지 않습니다.
KIS_APP_KEY=
KIS_APP_SECRET=

# ── 논문 수확 (선택 — 없어도 전부 돕니다) ────────────────────────────
#
# 키를 쓰는 곳은 한 곳뿐입니다. arXiv·OpenAlex·Crossref 는 키 없이 공개
# API 로 받습니다.
#
# S2_API_KEY — Semantic Scholar. 무료 신청:
#   https://www.semanticscholar.org/product/api#api-key-form
#   키가 없으면 전 세계가 나눠 쓰는 공용 풀이라 429 가 잦습니다.
S2_API_KEY=

# SSRN 은 셀프서비스 API 가 없습니다(Elsevier). 긁어 오는 것은 이용약관
# 위반이라 하지 않습니다 — 대신 Semantic Scholar 와 OpenAlex 가 색인한
# SSRN 프리프린트가 함께 들어옵니다.
